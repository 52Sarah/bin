{
    // number of days to keep files, 0 to disable deletion
    "history_retention": 30,           

    // file_name-XXXXXXXX.file_extension
    "format_timestamp": "%Y%m%d.%H%M%S",

    // only save LocalHistory after closing a file, not when original was saved
    "history_on_close": true,          

    "history_on_focus_lost": false,
    "history_on_load": true,

    // save to 'Sublime Text/Data/.sublime/Local History/...' instead of '~/.sublime/Local History/...'
    "portable": false,                  

    // redirect '~/.sublime/Local History/...' to some other place if "portable": false
    // "history_path": "", 

    // 4 MB
    "file_size_limit": 4194304,         

    // only save if most recent save is older than this (in minutes), 0 to disable
    "skip_if_saved_within_minutes": 1, 

    "show_full_path": false,

    // automatically opens a diff view when opening a file from history
    "auto_diff": false,                  

    // rename the tab to only include the timestamp, or the message in case of snapshots
    "rename_tab": false,                 
    
    "auto_save_before_diff": true
}

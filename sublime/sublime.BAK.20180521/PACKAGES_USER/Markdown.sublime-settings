{
	"caret_style": "smooth",
	"color_scheme": "Packages/User/SublimeLinter/MarkdownEditor-ArcDark (SL).tmTheme",
	"draw_centered": false,
	"extensions":
	[
		"mdown",
		"txt",
		"md",
		"mmd"

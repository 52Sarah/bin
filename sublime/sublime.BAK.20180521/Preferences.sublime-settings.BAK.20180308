{
	"auto_find_in_selection": true,
	"binary_file_patterns":
	[
		"*.alfdb",
		"*.ldb",
		"*.sublime_session",
		"*.min.js",
		"*.war.*",
		"*.amp",
		"*.bin",
		"*.dds",
		"*.doc",
		"*.docx",
		"*.eot",
		"*.gif",
		"*.ico",
		"*.jar",
		"*.jpeg",
		"*.jpg",
		"*.pdf",
		"*.png",
		"*.ppt",
		"*.pptx",
		"*.swf",
		"*.tga",
		"*.ttf",
		"*.war",
		"*.xls",
		"*.xlsx",
		"*.zip"
	],
	"bold_folder_labels": true,
	"caret_extra_bottom": 1,
	"caret_extra_top": 1,
	"caret_extra_width": 2,
	"color_inactive_tabs": true,
	"color_scheme": "Packages/User/SublimeLinter/Nice Blue Soda (SL).tmTheme",
	"copy_with_empty_selection": true,
	"detect_indentation": true,
	"drag_text": false,
	"draw_white_space": "selection",
	"ensure_newline_at_eof_on_save": true,
	"file_exclude_patterns":
	[
		"*.bin",
		"*.pyc",
		"*.pyo",
		"*.exe",
		"*.dll",
		"*.obj",
		"*.o",
		"*.a",
		"*.lib",
		"*.so",
		"*.dylib",
		"*.ncb",
		"*.sdf",
		"*.suo",
		"*.pdb",
		"*.idb",
		".DS_Store",
		"Icon?",
		"*.class",
		"*.psd",
		"*.db",
		"*.git-ignore",
		"stacktrace.log",
		"*-?.?.js*",
		"*-?.?.?.js*",
		"ucp-alfresco-liferay/**/alfresco/*.BAK*",
		"ucp-alfresco-liferay/**/alfresco/**/*.BAK*",
		"ucp-alfresco-liferay/**/liferay/*.BAK*",
		"ucp-alfresco-liferay/**/liferay/**/*.BAK*",
		"ucp-alfresco-liferay/**/liferay/themes/ucp-theme/docroot/js/ucp-webscript-utils.js"
	],
	"find_selected_text": true,
	"folder_exclude_patterns":
	[
		"*.cache",
		".git",
		".hg",
		".svn",
		"bin",
		"build",
		"BUILD",
		"clipboard.alfdb.data",
		"/Users/tpierzina/Dropbox/dotfiles/eclipse/dot_metadata/.plugins",
		"/Users/tpierzina/Dropbox/dotfiles/sublime/sublime_libdir/Local",
		"CVS",
		"DIST",
		"tomcat/temp",
		"tomcat/work",
		"ucp-alfresco-liferay/**/alfresco/*.BAK*",
		"ucp-alfresco-liferay/**/alfresco/**/*.BAK*",
		"ucp-alfresco-liferay/**/liferay/**/WEB-INF/classes",
		"ucp-alfresco-liferay/**/liferay/**/WEB-INF/**/classes",
		"ucp-alfresco-liferay/**/ucp-theme/docroot/css",
		"ucp-alfresco-liferay/**/ucp-theme/docroot/js",
		"ucp-alfresco-liferay/**/ucp-theme/docroot/templates",
		"ucp-myinfinitec/**/other_code",
		"ucp-myinfinitec/**/usermanagement/web-app/js/tinyMCE"
	],
	"font_face": "Source Code Pro Light",
	"font_size": 11.0,
	"highlight_line": true,
	"highlight_modified_tabs": true,
	"ignored_packages":
	[
		"Markdown",
		"MarkdownLight",
		"Vintage"
	],
	"indent_guide_options":
	[
		"draw_active"
	],
	"indent_to_bracket": false,
	"index_exclude_patterns":
	[
		"*.log",
		"*.csv"
	],
	"margin": 2,
	"match_brackets_angle": true,
	"move_to_limit_on_up_down": true,
	"open-sesame.projects_path": "~/Dropbox/dotfiles/sublime/projects",
	"open_files_in_new_window": false,
	"predawn_findreplace_small": true,
	"predawn_quick_panel_small": false,
	"predawn_sidebar_arrows": false,
	"predawn_sidebar_folder_gray": true,
	"predawn_sidebar_large": false,
	"predawn_sidebar_medium": false,
	"predawn_sidebar_narrow": false,
	"predawn_sidebar_small": false,
	"predawn_sidebar_xlarge": false,
	"predawn_sidebar_xsmall": true,
	"predawn_tabs_active_underline": true,
	"predawn_tabs_large": false,
	"predawn_tabs_medium": false,
	"predawn_tabs_small": true,
	"preferences_editor_indicate_default_settings": true,
	"preferences_editor_use_syntax_name": true,
	"rulers":
	[
	],
	"scroll_past_end": false,
	"shift_tab_unindent": true,
	"show_encoding": true,
	"show_full_path": true,
	"show_line_endings": true,
	"show_tab_close_buttons": false,
	"status_bar_brighter": true,
	"tab_size": 4,
	"tabs_padding_small": true,
	"tabs_small": true,
	"theme": "predawn-DEV.sublime-theme",
	"translate_tabs_to_spaces": true,
	"trim_trailing_white_space_on_save": true,
	"word_wrap": "auto"
}

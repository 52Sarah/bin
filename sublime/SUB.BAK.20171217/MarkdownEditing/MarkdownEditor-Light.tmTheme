<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!--
        #007    - dk blue  [blockquote]
        #00468b - dk blue  [heading]
        #2b2b2b - v dark gray  [foreground]
        #2e8a2e - dk mod lime green  [link]
        #393    - dk mod lime green
        #797979 - dk gray  [punctuation]
        #888    - dk gray  [comments]
        #c2e8ff - v pale blue  [selection]
        #ddd    - v lt gray  [line highlight]
        #e67e00 - pure orange  [list symbols]
        #e6f0ff - v pale blue  [heading background]
        #e7f7e7 - lt grayish lime green  [link background]
        #f2eee4 - lt grayish orange  [blockquote background]
        #f6f6f6 - v lt gray (mostly white)  [background]
    -->
    <dict>
        <key>name</key>
        <string>MarkdownEditing</string>
        <key>settings</key>
        <array>
            <dict>
                <key>settings</key>
                <dict>
                    <key>background</key>
                    <string>#f6f6f6</string><!-- v lt gray (mostly white) -->
                    <key>caret</key>
                    <string>#00bbff</string>
                    <key>foreground</key>
                    <string>#2b2b2b</string><!-- v dark gray -->
                    <key>invisibles</key>
                    <string>#E0E0E0</string>
                    <key>lineHighlight</key>
                    <string>#ddd</string><!-- v lt gray -->

                    <key>selection</key>
                    <string>#c2e8ff</string><!-- v pale blue -->
                    <key>selectionBorder</key>
                    <string>#AACBDF</string>
                    <key>inactiveSelection</key>
                    <string>#B5D3E5</string>
                    <key>findHighlight</key>
                    <string>#FFE792</string>
                    <key>findHighlightForeground</key>

                    <string>#000000</string>
                    <key>shadow</key>
                    <string>#808080</string>
                    <key>shadowWidth</key>
                    <string>6</string>
                </dict>
            </dict>

            <dict>
                <key>name</key>
                <string>Comments</string>
                <key>scope</key>
                <string>comment, comment punctuation</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#888</string><!-- dk gray -->
                </dict>
            </dict>
            <dict>

org.eclipse.jdt.ui.text.custom_code_templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="false" context\="catchblock_context" deleted\="false" description\="Code in new catch blocks" enabled\="true" id\="org.eclipse.jdt.ui.text.codetemplates.catchblock" name\="catchblock">throw new RuntimeException("ERROR caught in ${enclosing_method}\: " + ${exception_var}.getMessage(), ${exception_var});</template></templates>
org.eclipse.jdt.ui.text.custom_templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom try catch block" enabled\="true" id\="org.eclipse.jdt.ui.templates.try" name\="try_catch">try {\n  ${line_selection}${cursor}\n}\ncatch (Throwable ${exception_variable_name}) {\n  throw new RuntimeException("ERROR caught in ${enclosing_method}\: " + e.getMessage(), e);\n}\n</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom try finally block" enabled\="true" id\="org.eclipse.jdt.ui.templates.tryfinally" name\="try_finally">try {\n\t${line_selection}${cursor}\n}\nfinally {\n\t// ${todo}\: handle finally clause\n}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom catch block" enabled\="true" id\="org.eclipse.jdt.ui.templates.catch" name\="catch">catch (Throwable e) {\n    throw new RuntimeException("ERROR caught in ${enclosing_method}\: " + e.getMessage(), e);\n}</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom print to standard out" enabled\="true" id\="org.eclipse.jdt.ui.templates.sysout" name\="sysout">System.out.println(${word_selection}${});${cursor}</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom print to standard error" enabled\="true" id\="org.eclipse.jdt.ui.templates.syserr" name\="syserr">System.err.println(${word_selection}${});${cursor}</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom print current method to standard out" enabled\="true" id\="org.eclipse.jdt.ui.templates.systrace" name\="systrace">System.out.println("${enclosing_type}.${enclosing_method}()");</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.debug" enabled\="true" name\="ldebug">logger.debug("${word_selection}${}");${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.debug w format" enabled\="true" name\="lfdebug">logger.debug(String.format("${word_selection}${}", ${localVar}));${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.info w format" enabled\="true" name\="lfinfo">logger.info(String.format("${word_selection}${}", ${localVar}));${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace w format" enabled\="true" name\="lftrace">logger.trace(String.format("${word_selection}${}", ${localVar}));${cursor}</template><template autoinsert\="false" context\="java-members" deleted\="false" description\="\#custom Log4j Logger declaation" enabled\="true" name\="log4j_logger_declaration">private static final Logger logger \= Logger.getLogger(${enclosing_type}.class);${\:import(org.apache.log4j.Logger)}</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom re-throw as RTE" enabled\="true" name\="rethrow">throw new RuntimeException(e);\n</template><template autoinsert\="true" context\="java" deleted\="false" description\="\#custom logger.info for mutator" enabled\="true" name\="set_logger">logger.info("injected ${enclosing_method_arguments}\=" + ${enclosing_method_arguments});</template><template autoinsert\="false" context\="java" deleted\="false" description\="\#custom String.format(&quot;&quot;,x);" enabled\="true" name\="sf">String.format(${format_string\:word_selection('"%s"')}, ${cursor}${localVar})</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom wrap code in a TimedExecutor helper" enabled\="true" name\="timed_executor">${result_type\:argType(result_var)} ${result_var\:localVar(Object)} \= (${result_type}) (new TimedExecutor(logger) {\n    @Override protected Object timedMethod() {\n        //${todo} return ${result_type} ...\n\t\t${line_selection}\n    }\n}).run("${description}${cursor}");\n</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom throw new RuntimeException..." enabled\="true" name\="tnrte throw_new_runtimeexception">throw new RuntimeException("ERROR caught in ${enclosing_method}\: " + e.getMessage(), e);</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace at method start" enabled\="true" name\="ltms log_trace_method_start">logger.trace("START ${enclosing_method}");</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger trace" enabled\="true" name\="ltrace">logger.trace("${word_selection}${}");${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace.format at method start" enabled\="true" name\="ltfms log_trace_fmt_method_start">logger.trace(String.format("START ${enclosing_method}, ${p1\:localVar(String)}\=%s", ${p1}));</template><template autoinsert\="true" context\="java-statements" deleted\="false" description\="\#custom Write a sysout and INFO log in a static constructor, for debugging logging and classloading" enabled\="true" name\="log_static_classloaded">static {\n    System.out.println("CLASS LOADED\: ${enclosing_type}");\n    logger.info("Class loaded\: ${enclosing_type}");\n}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace at method start, 1 arg" enabled\="true" name\="ltmsa log_trace_method_start_arg">logger.trace("START ${enclosing_method}, ${localVar}\=" + ${localVar});</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace.format at method start, 1 arg" enabled\="true" name\="ltfms log_trace_fmt_method_start_arg">logger.trace(String.format("START ${enclosing_method}, ${p1\:localVar(String)}\=%s", ${p1}));\n</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace at method start" enabled\="true" name\="lttp log_trace_test_passed">logger.trace("PASSED ${enclosing_method}");</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.warn" enabled\="true" name\="lwarn">logger.warn("${word_selection}${}");${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.warn w format" enabled\="true" name\="lfwarn">logger.warn(String.format("${word_selection}${}", ${localVar}));${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.info" enabled\="true" name\="linfo">logger.info("${word_selection}${}");${cursor}</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace at test start" enabled\="true" name\="ltms log_trace_test_start">logger.trace("&gt;&gt;&gt; START-TEST ${enclosing_method}");</template><template autoinsert\="false" context\="java-statements" deleted\="false" description\="\#custom logger.trace at test finish" enabled\="true" name\="ltms log_trace_test_finish">logger.trace("&gt;&gt;&gt; FINISH-TEST ${enclosing_method}");</template></templates>

[alias]
    br = branch
    co = checkout
    st = status
    
    unstage = reset HEAD
    log1 = log --pretty=briefest
    log2 = log --pretty=briefer
    log3 = log --pretty=brief

[color]
    ui = always

[core]
    editor = subl

[diff]
    tool = bc3

[log]
    # Thu 10/11/18 18:31
    date = format:%a %D %H:%M

[merge]
    tool = bc3

[mergetool "bc3"]
    trustExitCode = true

[pretty]
    # commit(abbrev), author, date, subject, [ref names]
    briefest = %Cgreen%h%Creset  %<(15,trunc)%cn  %cd  %<(64,trunc)%s %>>(1)%Cblue%d%Creset

    # commit(abbrev), author, date (rel date), [ref names]; subject
    briefer = %Cgreen%h%Creset  %<(20,trunc)%cn  %cd (%cr) %>>(1)%Cblue%d%Creset%n    %s

    # commit(abbrev), author, date (rel date), [ref names]; subject; blank
    brief = %Cgreen%h%Creset  %<(20,trunc)%cn  %cd (%cr) %>>(1)%Cblue%d%Creset%n    %s%n

